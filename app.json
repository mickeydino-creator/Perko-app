{
  "expo": {
    "name": "Perko",
    "slug": "perko",
    "scheme": "perko",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "backgroundColor": "#EBECE4",
    "primaryColor": "#11130F",
    "platforms": [
      "ios",
      "android",
      "web"
    ],
    "ios": {
      "bundleIdentifier": "org.perko.app",
      "buildNumber": "1",
      "supportsTablet": false
    },
    "android": {
      "package": "org.perko.app",
      "versionCode": 1,
      "userInterfaceStyle": "automatic",
      "adaptiveIcon": {
        "backgroundColor": "#D7FF35",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "permissions": [
        "android.permission.CAMERA"
      ],
      "blockedPermissions": [
        "android.permission.RECORD_AUDIO"
      ],
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro",
      "output": "single"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#D7FF35",
          "image": "./assets/splash-icon.png",
          "imageWidth": 160,
          "android": {
            "backgroundColor": "#D7FF35",
            "image": "./assets/splash-icon.png",
            "imageWidth": 160
          }
        }
      ],
      "expo-status-bar",
      "expo-secure-store",
      [
        "expo-localization",
        {
          "supportsRTL": true,
          "forcesRTL": true
        }
      ],
      "expo-web-browser",
      [
        "expo-camera",
        {
          "cameraPermission": "Perko משתמשת במצלמה רק כדי לסרוק את קוד ה-QR שבקופה.",
          "recordAudioAndroid": false,
          "barcodeScannerEnabled": true
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Perko משתמשת במיקום רק כדי להראות במפה עסקים קרובים אליך. המיקום נשאר בטלפון ולא נשלח לשרת.",
          "isAndroidBackgroundLocationEnabled": false,
          "isIosBackgroundLocationEnabled": false
        }
      ],
      [
        "expo-navigation-bar",
        {
          "style": "dark",
          "enforceContrast": false
        }
      ],
      "expo-system-ui"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
