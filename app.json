{
  "expo": {
    "name": "Perko",
    "slug": "perko",
    "scheme": "perko",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "backgroundColor": "#EBECE4",
    "primaryColor": "#11130F",
    "platforms": ["android", "web"],
    "android": {
      "package": "org.perko.app",
      "versionCode": 1,
      "userInterfaceStyle": "light",
      "adaptiveIcon": {
        "backgroundColor": "#D7FF35",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "permissions": ["android.permission.CAMERA"],
      "blockedPermissions": ["android.permission.RECORD_AUDIO"],
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro",
      "output": "single"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#D7FF35",
          "image": "./assets/splash-icon.png",
          "imageWidth": 160,
          "android": { "backgroundColor": "#D7FF35", "image": "./assets/splash-icon.png", "imageWidth": 160 }
        }
      ],
      "expo-status-bar",
      "expo-secure-store",
      ["expo-localization", { "supportsRTL": true, "forcesRTL": true }],
      "expo-web-browser",
      [
        "expo-camera",
        {
          "cameraPermission": "Perko משתמשת במצלמה רק כדי לסרוק את קוד ה-QR שבקופה.",
          "recordAudioAndroid": false,
          "barcodeScannerEnabled": true
        }
      ],
      ["expo-navigation-bar", { "style": "dark", "enforceContrast": false }],
      "expo-system-ui"
    ],
    "experiments": { "typedRoutes": true }
  }
}
