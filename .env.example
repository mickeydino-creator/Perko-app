# Copy to .env and fill in from your Supabase project (Project settings > API).
# Leave both empty to run the app in demo mode (local sample data, no backend, any 6-digit SMS code).
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Only for scripts/admin.ts on your own machine. Never prefix with EXPO_PUBLIC_, never commit.
# SUPABASE_URL=
# SUPABASE_SERVICE_ROLE_KEY=
# QR_SECRET_V1=
