{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "types": [
      "node"
    ]
  },
  "include": [
    "**/*.ts",
    "**/*.tsx",
    ".expo/types/**/*.ts",
    "expo-env.d.ts"
  ],
  "exclude": [
    "node_modules",
    "supabase/functions/collect",
    "supabase/functions/redeem",
    "supabase/functions/delete-account",
    "supabase/functions/business-admin",
    "supabase/functions/_shared/server.ts",
    "supabase/functions/_shared/pins.ts",
    "supabase/dashboard"
  ]
}
